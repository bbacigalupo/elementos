# Copia este archivo a .env.local y completa la(s) clave(s) que uses.
# Sin ninguna, el playground usa Photon, que no necesita registro.
LOCATIONIQ_KEY=

# Prueba de Mapbox en local (22 sept 2026): con MAPBOX_TOKEN puesto y sin
# GEO_PROVIDER, el playground usa Mapbox automáticamente si no hay
# LOCATIONIQ_KEY, o dejando GEO_PROVIDER=mapbox para forzarlo aunque las dos
# claves estén presentes (así se puede alternar sin comentar/descomentar
# nada). Queda en modo temporal (no se guardan resultados) hasta decidir si
# vale la pena pagar el plan permanente de Mapbox — ver providers/mapbox.ts.
MAPBOX_TOKEN=
GEO_PROVIDER=
