# Clave real de LocationIQ (la misma cuenta que ya usa el resto del proyecto).
LOCATIONIQ_KEY=

# Dominio(s) exactos de WordPress que pueden llamar a este backend, separados
# por coma. Sin comodín "*" a propósito: con comodín, cualquier sitio podría
# gastar la cuota desde el navegador de sus visitantes.
ALLOWED_ORIGIN=https://allrideapp.com

# Tope propio de consultas diarias, con margen bajo la cuota real del plan
# de LocationIQ — para enterarse ANTES de que el proveedor empiece a
# rechazar. Ajustar según el plan contratado.
DAILY_QUOTA=450
