{
  "name": "@allride/geo-core",
  "version": "0.7.0",
  "type": "module",
  "description": "Núcleo de geolocalización: tipos, parser de coordenadas, proveedores de geocoding intercambiables y handlers HTTP portables. Sin dependencias, sin UI.",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/http/node.d.ts",
      "default": "./dist/http/node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p ."
  }
}
