{
  "name": "@allride/address-batch",
  "version": "0.1.0",
  "type": "module",
  "description": "Elemento reutilizable de geocodificación masiva: pegar o cargar muchas direcciones, procesarlas con feedback, revisar lo incierto y exportar.",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/BatchMap.d.ts",
      "default": "./dist/BatchMap.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-assets.mjs address-batch styles.css",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@allride/address-input": "^0.8.0",
    "@allride/geo-core": "^0.8.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "xlsx": ">=0.18"
  },
  "peerDependenciesMeta": {
    "xlsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
