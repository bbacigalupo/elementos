{
  "name": "@bbacigalupo/address-input",
  "version": "0.8.0",
  "type": "module",
  "description": "Input reutilizable de captura de direcciones: autocompletado con fallback, pin en mapa, GPS y coordenadas manuales, siempre con confirmación visual.",
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbacigalupo/elementos.git",
    "directory": "packages/address-input"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-assets.mjs address-input styles.css",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@bbacigalupo/geo-core": "^0.9.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
