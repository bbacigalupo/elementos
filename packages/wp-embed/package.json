{
  "name": "@bbacigalupo/wp-embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bundle standalone de @bbacigalupo/address-batch para embeber con un <script> en WordPress u otro sitio sin build propio.",
  "scripts": {
    "build": "vite build && node copy-to-plugin.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@bbacigalupo/address-batch": "*",
    "@bbacigalupo/geo-core": "*",
    "leaflet": "^1.9.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5.7",
    "vite": "^7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
